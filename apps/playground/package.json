{
    "name": "audio-playground",
    "version": "2.3.2",
    "main": "src/index",
    "scripts": {
        "eas-build-pre-install": "bash scripts/eas-build-pre-install.sh",
        "postinstall": "patch-package",
        "build:deps": "cd ../../packages/audio-studio && yarn build && yarn build:plugin && cd ../playgroundapi && yarn build && cd ../react-native-essentia && yarn prepare",
        "start": "NODE_ENV=development APP_VARIANT=development bash scripts/agentic/start-metro.sh && node scripts/agentic/start-interactive.mjs",
        "stop": "bash scripts/agentic/stop-metro.sh",
        "android": "APP_VARIANT=development PLATFORM=android HEADLESS=0 REBUILD=1 bash scripts/agentic/preflight.sh",
        "ios": "APP_VARIANT=development PLATFORM=ios HEADLESS=0 REBUILD=1 bash scripts/agentic/preflight.sh",
        "ios:boot": "../../scripts/ios-launch.sh --simulator \"${IOS_SIMULATOR:-playground-1}\" --boot-only",
        "ios:launch": "APP_VARIANT=development PLATFORM=ios HEADLESS=0 SKIP_BUILD=1 bash scripts/agentic/preflight.sh",
        "ios:select": "../../scripts/ios-launch.sh --select --scheme audioplayground-development --port 7365",
        "android:launch": "APP_VARIANT=development PLATFORM=android HEADLESS=0 SKIP_BUILD=1 bash scripts/agentic/preflight.sh",
        "android:select": "APP_VARIANT=development ANDROID_PACKAGE=net.siteed.audioplayground.development ANDROID_ACTIVITY=net.siteed.audioplayground.MainActivity ../../scripts/android-launch.sh --select --scheme audioplayground-development --port 7365",
        "launch": "APP_VARIANT=development ANDROID_PACKAGE=net.siteed.audioplayground.development ANDROID_ACTIVITY=net.siteed.audioplayground.MainActivity ../../scripts/device-launch.sh --scheme audioplayground-development --port 7365",
        "web": "NODE_ENV=development APP_VARIANT=development bash scripts/agentic/start-metro.sh && node scripts/agentic/web-browser.mjs launch",
        "devices": "node scripts/agentic/cdp-bridge.mjs list-devices",
        "status": "node scripts/agentic/cdp-bridge.mjs list-devices",
        "benchmark:moonshine:longform": "BENCHMARK_PRESET=moonshine-longform node scripts/agentic/direct-asr-benchmark.mjs",
        "benchmark:moonshine:diarization": "node scripts/agentic/moonshine-speaker-turn-validation.mjs",
        "reload": "bash scripts/agentic/device-cmd.sh reload",
        "wake": "bash scripts/agentic/wake-devices.sh",
        "debug": "bash scripts/agentic/device-cmd.sh debug",
        "dev-menu": "bash scripts/agentic/device-cmd.sh dev-menu",
        "typecheck": "bash scripts/typecheck.sh",
        "test:config": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' node -r ts-node/register --test config/validate-env.test.ts src/utils/moonshineDiarizationRuntime.test.ts src/utils/moonshineIntentModelFiles.test.ts",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "lint:fix-nullish": "bash scripts/fix-nullish-coalescing.sh",
        "lint:fix-imports": "bash scripts/fix-unused-imports.sh",
        "clean": "rimraf dist",
        "publish": "bash scripts/deploy-playground.sh",
        "setup:development": "scripts/setup-env.sh development",
        "setup:preview": "scripts/setup-env.sh preview",
        "setup:production": "scripts/setup-env.sh production",
        "setup:development:force": "scripts/setup-env.sh development force",
        "setup:preview:force": "scripts/setup-env.sh preview force",
        "setup:production:force": "scripts/setup-env.sh production force",
        "screenshot:development": "yarn setup:development && ./scripts/generate-screenshots.sh all env=development",
        "screenshot:preview": "yarn setup:preview && ./scripts/generate-screenshots.sh all env=development",
        "screenshot:production": "yarn setup:production && ./scripts/generate-screenshots.sh all env=production",
        "screenshot:android": "./scripts/generate-screenshots.sh android",
        "screenshot:android:production": "yarn setup:production && ./scripts/generate-screenshots.sh android env=production",
        "prepare:appstore": "yarn setup:production && ./scripts/setup-simulators.sh && ./scripts/generate-screenshots.sh ios env=production && echo 'App Store preparation complete! Screenshots are ready in fastlane/detox/ios.'",
        "prepare:appstore:force": "yarn setup:production:force && ./scripts/setup-simulators.sh && ./scripts/generate-screenshots.sh ios force env=production && echo 'App Store preparation complete with forced rebuild!'",
        "prepare:playstore": "yarn setup:production && ./scripts/setup-simulators.sh && ./scripts/generate-screenshots.sh android env=production && echo 'Play Store preparation complete! Screenshots are ready in fastlane/detox/android.'",
        "prepare:playstore:force": "yarn setup:production:force && ./scripts/setup-simulators.sh && ./scripts/generate-screenshots.sh android force env=production && echo 'Play Store preparation complete with forced rebuild!'",
        "prepare:stores": "yarn setup:production && ./scripts/setup-simulators.sh && yarn screenshot:production && echo 'All store screenshots ready!'",
        "build:android:test": "APP_VARIANT=development yarn dlx eas-cli build --platform android --profile test --local",
        "build:android:development": "APP_VARIANT=development yarn dlx eas-cli build --platform android --profile development --local",
        "build:android:preview": "APP_VARIANT=preview yarn dlx eas-cli build --platform android --profile preview --local",
        "build:android:preview_apk": "APP_VARIANT=preview_apk yarn dlx eas-cli build --platform android --profile preview_apk --local",
        "build:android:production": "NODE_ENV=production APP_VARIANT=production yarn dlx eas-cli build --platform android --profile production",
        "build:android:production:local": "NODE_ENV=production APP_VARIANT=production yarn dlx eas-cli build --platform android --profile production --local --no-wait",
        "build:ios:test": "APP_VARIANT=development yarn dlx eas-cli build --platform ios --profile test --local",
        "build:ios:development": "APP_VARIANT=development NODE_ENV=development yarn dlx eas-cli build --platform ios --profile development --local",
        "build:ios:preview": "APP_VARIANT=preview NODE_ENV=development yarn dlx eas-cli build --platform ios --profile preview --local",
        "build:ios:production": "NODE_ENV=production APP_VARIANT=production yarn dlx eas-cli build --platform ios --profile production",
        "build:ios:production:local": "NODE_ENV=production APP_VARIANT=production yarn dlx eas-cli build --platform ios --profile production --local --no-wait",
        "detox:build:android": "detox build -c android.att.debug",
        "detox:build:android:emu": "detox build -c android.emu.release",
        "detox:build:android:emu:debug": "detox build -c android.emu.debug",
        "e2e:android:record": "detox test -c android.att.debug -o e2e/record.test.ts",
        "e2e:android:screenshots": "detox test -c android.att.debug -o e2e/screenshots.test.ts",
        "e2e:android:emu:screenshots": "detox test -c android.emu.release e2e/screenshots.test.ts",
        "e2e:android:import": "detox test -c android.att.debug -o e2e/import.test.ts",
        "detox:build:ios": "detox build -c ios.sim.debug",
        "e2e:ios:record": "detox test -c ios.sim.debug -o e2e/record.test.ts",
        "e2e:ios:screenshots": "detox test -c ios.sim.debug -o e2e/screenshots.test.ts",
        "e2e:ios:import": "detox test -c ios.sim.debug -o e2e/import.test.ts",
        "e2e:ios:storybook": "EXPO_PUBLIC_STORYBOOK=true detox test -c ios.sim.debug -o e2e/storybook-validation.test.ts",
        "e2e:android:storybook": "EXPO_PUBLIC_STORYBOOK=true detox test -c android.att.debug -o e2e/storybook-validation.test.ts",
        "open:ios": "open -a Xcode ios/AudioDevPlayground.xcworkspace 2>/dev/null || $(dirname $(dirname $(xcode-select -p)))/Contents/MacOS/Xcode $(pwd)/ios/AudioDevPlayground.xcworkspace &",
        "open:android": "open -a \"Android Studio\" android",
        "predeploy": "APP_VARIANT=production EXPO_WEB=true expo export -p web",
        "serve:dev": "yarn clean && NODE_ENV=development APP_VARIANT=development EXPO_WEB=true expo export -p web && yarn serve dist/",
        "prepare": "cd ../../ && husky install apps/playground/.husky",
        "benchmark:asr:direct": "node scripts/agentic/direct-asr-benchmark.mjs",
        "update-runtime-version": "node scripts/update-runtime-version.js",
        "update:patch": "yarn version --patch && yarn update-runtime-version",
        "update:minor": "yarn version --minor && yarn update-runtime-version",
        "update:major": "yarn version --major && yarn update-runtime-version",
        "ota-update": "yarn update-runtime-version && yarn dlx eas-cli update --auto",
        "ota-update:production": "yarn update-runtime-version && yarn dlx eas-cli update --auto --branch production --message \"$(git log -1 --pretty=%B)\"",
        "ota-update:preview": "yarn update-runtime-version && yarn dlx eas-cli update --auto --branch preview --message \"$(git log -1 --pretty=%B)\"",
        "ota-update:development": "yarn update-runtime-version && yarn dlx eas-cli update --auto --branch development --message \"$(git log -1 --pretty=%B)\"",
        "setup:ios-simulator": "./scripts/setup-simulators.sh",
        "setup:android-emulator": "./scripts/setup-simulators.sh",
        "storybook": "EXPO_PUBLIC_STORYBOOK=true EXPO_USE_METRO_WORKSPACE_ROOT=1 NODE_ENV=development expo start --dev-client --port 7366",
        "storybook:ios": "EXPO_PUBLIC_STORYBOOK=true RCT_METRO_PORT=7366 NODE_ENV=development expo run:ios --device --port 7366",
        "storybook:android": "EXPO_PUBLIC_STORYBOOK=true RCT_METRO_PORT=7366 NODE_ENV=development expo run:android --port 7366",
        "storybook:web": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:stories": "jest --config jest.config.stories.js",
        "test:stories:watch": "jest --config jest.config.stories.js --watch",
        "test:stories:coverage": "jest --config jest.config.stories.js --coverage",
        "deploy": "",
        "android:headless": "APP_VARIANT=development PLATFORM=android HEADLESS=1 REBUILD=1 bash scripts/agentic/preflight.sh",
        "ios:headless": "APP_VARIANT=development PLATFORM=ios HEADLESS=1 REBUILD=1 bash scripts/agentic/preflight.sh",
        "android:device": "APP_VARIANT=development PLATFORM=android ANDROID_DEVICE= EMULATOR_PORT= REBUILD=1 bash scripts/agentic/preflight.sh",
        "android:device:launch": "APP_VARIANT=development PLATFORM=android ANDROID_DEVICE= EMULATOR_PORT= SKIP_BUILD=1 bash scripts/agentic/preflight.sh",
        "ios:device": "APP_VARIANT=development PLATFORM=ios IOS_SIMULATOR= REBUILD=1 bash scripts/agentic/preflight.sh",
        "ios:device:launch": "APP_VARIANT=development PLATFORM=ios IOS_SIMULATOR= SKIP_BUILD=1 bash scripts/agentic/preflight.sh",
        "recipe": "node ../../scripts/agentic/recipe/run.mjs",
        "recipe:run": "node ../../scripts/agentic/recipe/run.mjs run",
        "recipe:validate": "node ../../scripts/agentic/recipe/run.mjs validate",
        "recipe:doctor": "node ../../scripts/agentic/recipe/run.mjs doctor",
        "recipe:manifest": "node ../../scripts/agentic/recipe/run.mjs manifest",
        "recipe:list": "node ../../scripts/agentic/recipe/run.mjs list",
        "recipe:dry-run": "node ../../scripts/agentic/recipe/run.mjs run --dry-run",
        "recipe:matrix": "node ../../scripts/agentic/recipe/run.mjs run --matrix web,ios,android",
        "recipe:asr-benchmark": "node ../../scripts/agentic/recipe/run.mjs run playground.asr-benchmark-screen-validation"
    },
    "dependencies": {
        "@expo/metro-runtime": "~58.0.15",
        "@expo/vector-icons": "^15.1.1",
        "@gorhom/bottom-sheet": "^5.2.8",
