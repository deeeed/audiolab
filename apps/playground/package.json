        "@xenova/transformers": "^2.17.2",
        "buffer": "^6.0.3",
        "canvaskit-wasm": "0.41.0",
        "crc-32": "^1.2.2",
        "debug": "^4.3.4",
        "expo": "^58.0.21",
        "expo-application": "~58.1.2",
        "expo-asset": "~58.0.19",
        "expo-audio": "~58.0.10",
        "expo-background-task": "~58.0.11",
        "expo-build-properties": "~58.0.11",
        "expo-clipboard": "~58.0.4",
        "expo-constants": "~58.0.14",
        "expo-device": "~58.0.5",
        "expo-document-picker": "~58.0.4",
        "expo-file-system": "~58.0.13",
        "expo-font": "~58.0.11",
        "expo-linking": "~58.0.15",
        "expo-localization": "~58.0.5",
