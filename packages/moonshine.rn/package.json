{
  "name": "@siteed/moonshine.rn",
  "version": "0.4.2-beta.0",
  "description": "React Native wrapper for Moonshine Voice on-device transcription",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "prebuilt",
    "!prebuilt/ios/Moonshine.xcframework/**",
    "!prebuilt/ios/current/**",
    "!prebuilt/ios/Moonshine.xcframework.zip",
    "!prebuilt/android/moonshine-voice-source-release.aar",
    "!prebuilt/android/moonshine-voice-isolated.aar",
    "!prebuilt/web/model/**",
    "patches",
    "scripts/ensure-ios-artifacts.sh",
    "scripts/ensure-android-artifacts.sh",
    "*.podspec",
    "apply-upstream-patches.sh",
    "build-moonshine-android.sh",
    "build-moonshine-ios.sh",
    "build-moonshine-web.sh",
    "react-native.config.js",
    "setup.sh",
    "!ios/build",
    "!android/build",
    "!android/src/test/**",
    "!android/src/androidTest/**",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "clean": "del-cli android/build lib",
    "setup:upstream": "bash ./setup.sh",
    "build:android:source": "bash ./build-moonshine-android.sh",
    "build:ios:source": "bash ./build-moonshine-ios.sh",
    "build:web:source": "bash ./build-moonshine-web.sh",
    "prepare": "bob build",
    "pack:check": "npm pack --json --dry-run",
    "release:preflight": "yarn typecheck && yarn test && yarn test:ios-artifacts-script && yarn validate:native-release",
    "release:beta:preflight": "yarn release:preflight",
    "validate:offline:contract": "node ./scripts/validate-offline-contract.mjs",
    "validate:native-release": "node ./scripts/validate-native-release.mjs",
    "validate:android-release-artifact": "node ./scripts/validate-android-release-artifact.mjs",
    "validate:ios-release-artifact": "node ./scripts/validate-ios-release-artifact.mjs",
    "prepublishOnly": "yarn release:preflight && yarn validate:android-release-artifact && yarn validate:ios-release-artifact",
    "test:ios-artifacts-script": "node ./scripts/test-ios-artifacts-script.mjs"
  },
  "keywords": [
    "react-native",
    "android",
    "moonshine",
    "speech-to-text",
    "stt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deeeed/audiolab/.git"
  },
  "author": "Arthur Breton <abreton@siteed.net> (https://github.com/deeeed)",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "llama-tokenizer-js": "^1.2.2",
    "onnxruntime-web": "^1.22.0"
  },
  "nativePackage": true,
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@react-native/eslint-config": "^0.73.1",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.2.0",
    "del-cli": "^5.1.0",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.37.0",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "yarn@4.2.2",
  "moonshineVersion": "v0.0.59",
  "moonshineAndroidVersion": "0.1.5",
  "_moonshineCommit": "The exact upstream commit the submodule gitlink pins. The tag's tree is NOT the same: core/speaker-embedding-model-data.cpp, which core/CMakeLists.txt lists unconditionally, is absent at v0.0.59 (#442). moonshineVersion is for display only.",
  "moonshineCommit": "520ba083085a14efcb77d701b35544f81d7b1acf",
  "moonshineArtifacts": {
    "android": {
      "isolatedAarSha256": "c83f8bc94cccc42e7d89fce0d3b74df83c50d789641281ddd430bdb51f36b5dc"
    },
    "ios": {
      "xcframeworkSha256": "57e0386252aca361f64094bb567f14ce16080bb6aed2fc674dceaac5d3ffcc93"
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "esModuleInterop": true,
            "jsx": "react",
            "module": "commonjs",
            "target": "es2019"
          }
        }
      ]
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "legacy-module",
    "languages": "kotlin-swift",
    "version": "0.48.3"
  },
  "moonshineJsVersion": "0.2.0",
  "moonshineJsGitHead": "59c9c83669e464d3e3f00d85c850d4327bef9009"
}
